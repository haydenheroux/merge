package main

templ Base(title, description, baseURL string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<title>{ title }</title>
		<link rel="stylesheet" href="/public/main.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&family=Neuton:ital,wght@0,200;0,300;0,400;0,700;0,800;1,400&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
		<meta name="description" content={ description }/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta property="og:title" content={ title }/>
		<meta property="og:type" content="website"/>
		<meta property="og:url" content={ baseURL }/>
		<meta property="og:description" content={ description }/>
	</head>
	<body>
		@Nav()
		{ children... }
		<script src="/public/pr-toggle.js" defer></script>
		<script defer>
			document.addEventListener('submit', function(e) {
				var form = e.target.closest('.repo-form');
				if (!form) return;
				e.preventDefault();
				var owner = form.querySelector('.owner-input').value.trim();
				var repo = form.querySelector('.repo-input').value.trim();
				if (repo) {
					window.location.href = '/' + owner + '/' + repo;
				}
			});
		</script>
	</body>
	</html>
}