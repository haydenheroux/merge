package components

import (
	"fmt"
	"merge/internal/model"
)

templ Contributor(info model.ContributorInfo, owner, repo string) {
    <div class="item contributor" hx-get={ fmt.Sprintf("/%s/%s?contributor=%s", owner, repo, info.Name) } hx-target="main" hx-push-url="true">
        <img class="avatar" src={ info.AvatarURL } alt={ fmt.Sprintf("%s's avatar", info.Name) }/>
        <div class="text">
            <span class="title">{ info.Name }</span>
            <p class="age">{ info.NewestPRAge }</p>
        </div>
    </div>
}
