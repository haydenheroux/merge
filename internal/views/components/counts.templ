package components

import (
	"strings"

	"merge/internal/model"
)

func statusURL(filters model.FilterSet, targetStatus string) string {
	if filters.Status == targetStatus {
		return filters.WithStatus("").URL()
	}
	return filters.WithStatus(targetStatus).URL()
}

func buildFilterLabel(filters model.FilterSet) string {
	parts := []string{}
	if filters.Scope != "" {
		parts = append(parts, strings.ToUpper(filters.Scope))
	}
	if filters.Status != "" {
		parts = append(parts, strings.ToUpper(filters.Status))
	}
	if filters.Contributor != "" {
		parts = append(parts, strings.ToUpper(filters.Contributor))
	}
	return "Filter: " + strings.Join(parts, ", ")
}

templ Counts(counts model.ExpiryCounts, hasMore bool, filters model.FilterSet, nextPage int) {
	<div class="stats">
		<div class="section-heading">
            <span>Overview</span>
			<div class="buttons">
				if filters.Scope != "" || filters.Contributor != "" || filters.Status != "" {
					<button class="filter-toggle" id="filter-toggle" type="button" aria-label="Toggle filter" hx-on:click="Alpine.store('filterPanel').openPanel()">{ buildFilterLabel(filters) }</button>
					<a class="link-button" id="filter-clear"
						href={ templ.SafeURL(filters.URL()) }
						hx-get={ templ.SafeURL(filters.URL()) }
						hx-target="main"
						hx-push-url="true">Clear</a>
				} else {
					<button class="filter-toggle" id="filter-toggle" type="button" aria-label="Toggle filter" hx-on:click="Alpine.store('filterPanel').openPanel()">Filter</button>
				}
			</div>
        </div>
		<div class="stats-tiles">
			@Count("fa-seedling ok", counts.FreshCount, "fresh", statusURL(filters, "fresh"), filters.Status == "fresh")
			@Count("fa-leaf warn", counts.StaleCount, "stale", statusURL(filters, "stale"), filters.Status == "stale")
			@Count("fa-skull error", counts.ExpiredCount, "expired", statusURL(filters, "expired"), filters.Status == "expired")
			@Count("fa-code-merge special", counts.MergedCount, "merged", statusURL(filters, "merged"), filters.Status == "merged")
		</div>
	</div>
}
