package components

import (
	"fmt"
	"math"
	"strings"
	"time"

	"merge/internal/model"
	"merge/internal/views/helpers"
)

func paneAgeLabel(open time.Duration, days int) string {
	if open.Hours() < 1 {
		mins := int(math.Floor(open.Minutes()))
		return fmt.Sprintf("%dm ago", mins)
	}

	if days < 1 {
		hrs := int(math.Floor(open.Hours()))
		return fmt.Sprintf("%dhrs ago", hrs)
	}

	if days == 1 {
		return "Yesterday"
	}

	if days < 7 {
		return fmt.Sprintf("%dd ago", days)
	}

	weeks := days / 7
	if weeks < 4 {
		return fmt.Sprintf("%dwk ago", weeks)
	}

	months := weeks / 4
	if months < 12 {
		return fmt.Sprintf("%dmo ago", months)
	}

	years := months / 12
	return fmt.Sprintf("%dyr ago", years)
}

templ PaneContent(pr model.StampedPullRequest, owner, repo, currentPath string) {
	<div class="pane-right-header">
		<a class="pane-right-title" href={ pr.URL }>
			<i class={ "status-icon fa-solid " + helpers.GetStatusClass(pr) }></i>
			if pr.Title != "" {
				@Markdown(pr.Title)
			} else {
				Pull Request
			}
			<i class="fa-solid fa-up-right-from-square"></i>
		</a>
		<button class="button-toggle" aria-label="Close">
			<i class="fa-solid fa-xmark" aria-hidden="true"></i>
		</button>
	</div>
	<div class="pane-right-body scroll">
		<div class="pane-right-meta">
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-hashtag"></i>
					Number
				</span>
				<span class="meta-value">{ fmt.Sprintf("#%d", pr.Number) }</span>
			</div>
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-code-pull-request"></i>
					Status
				</span>
				<span class="meta-value">{ pr.State }</span>
			</div>
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-clock"></i>
					Age
				</span>
				<span class="meta-value">{ paneAgeLabel(pr.TimeOpen, pr.DaysOpen) }</span>
			</div>
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-user"></i>
					Author
				</span>
				{{ authorPath := helpers.StripQueryParam(currentPath, "contributor")
				currentStatus := helpers.GetQueryParam(currentPath, "status")
				q := []string{"contributor=" + pr.Author.Name}
				if currentStatus != "" {
					q = append(q, "status="+currentStatus)
				}
				authorURL := authorPath + "?" + strings.Join(q, "&")
				}}
				<a
					class="meta-value meta-link"
					href={ templ.SafeURL(authorURL) }
					hx-get={ templ.SafeURL(authorURL) }
					hx-target="section.prs"
					hx-push-url="true"
				>{ pr.Author.Name }</a>
			</div>
			if len(pr.Scopes) > 0 {
				<div class="meta-row">
					<span class="meta-label">
						<i class="fa-solid fa-tag"></i>
						Scope
					</span>
					{{ scopeURL := fmt.Sprintf("/%s/%s/%s", owner, repo, pr.Scopes[0])
					q := []string{}
					if pr.Author.Name != "" {
						q = append(q, "contributor="+pr.Author.Name)
					}
					if currentStatus != "" {
						q = append(q, "status="+currentStatus)
					}
					if len(q) > 0 {
						scopeURL += "?" + strings.Join(q, "&")
					}
					}}
					<a
						class="meta-value meta-link"
						href={ templ.SafeURL(scopeURL) }
						hx-get={ templ.SafeURL(scopeURL) }
						hx-target="section.prs"
						hx-push-url="true"
					>{ pr.Scopes[0] }</a>
				</div>
			}
		</div>
		@Markdown(pr.Body)
	</div>
}
