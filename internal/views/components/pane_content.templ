package components

import (
	"fmt"

	"merge/internal/model"
	"merge/internal/views/helpers"
)

templ PaneContent(pr model.StampedPullRequest, owner, repo, currentPath string) {
	<div class="context-pane-header">
		<a class="context-pane-title" href={ pr.URL }>
			<i class={ "status-icon fa-solid " + helpers.GetStatusClass(pr) }></i>
			if pr.Title != "" {
				@Markdown(pr.Title)
			} else {
				Pull Request
			}
			<i class="fa-solid fa-up-right-from-square"></i>
		</a>
		<button class="button-toggle" aria-label="Close" onclick="Alpine.store('contextPane').closePane()">
			<i class="fa-solid fa-xmark" aria-hidden="true"></i>
		</button>
	</div>
	<div class="context-pane-body scroll">
		<div class="context-pane-meta">
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-hashtag"></i>
					Number
				</span>
				<span class="meta-value">{ fmt.Sprintf("#%d", pr.Number) }</span>
			</div>
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-code-pull-request"></i>
					Status
				</span>
				<span class="meta-value">{ pr.State }</span>
			</div>
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-clock"></i>
					Age
				</span>
				<span class="meta-value">{ model.TimeAgo(pr.TimeOpen, pr.DaysOpen) }</span>
			</div>
			<div class="meta-row">
				<span class="meta-label">
					<i class="fa-solid fa-user"></i>
					Author
				</span>
				<a
					class="meta-value meta-link"
					href={ templ.SafeURL(helpers.StripQueryParam(currentPath, "contributor") + "?contributor=" + pr.Author.Name) }
					hx-get={ templ.SafeURL(helpers.StripQueryParam(currentPath, "contributor") + "?contributor=" + pr.Author.Name) }
					hx-target="section.scroll"
					hx-push-url="true"
				>{ pr.Author.Name }</a>
			</div>
			if len(pr.Scopes) > 0 {
				<div class="meta-row">
					<span class="meta-label">
						<i class="fa-solid fa-tag"></i>
						Scope
					</span>
					<a
						class="meta-value meta-link"
						href={ templ.SafeURL(fmt.Sprintf("/%s/%s/%s", owner, repo, pr.Scopes[0])) }
						hx-get={ templ.SafeURL(fmt.Sprintf("/%s/%s/%s", owner, repo, pr.Scopes[0])) }
						hx-target="section.scroll"
						hx-push-url="true"
					>{ pr.Scopes[0] }</a>
				</div>
			}
		</div>
		@Markdown(pr.Body)
	</div>
}
