package components

import "merge/internal/model"

templ Contributors(contributors []model.ContributorInfo, activeSort string) {
    if len(contributors) > 0 {
        <div class="list-section">
            <div class="section-header">
                <span class="section-title">Contributors</span>
                <span class="section-actions">
                    <i id="contributors-sort-indicator" class="fas fa-circle-notch fa-spin htmx-indicator" style="display:none"></i>
                    <button
                        if activeSort == "top" {
                            data-active="true"
                        }
                        hx-get="?part=contributors&sort=top"
                        hx-target="#contributors-section"
                        hx-indicator="#contributors-sort-indicator"
                    >Top</button>
                    <button
                        if activeSort == "recent" {
                            data-active="true"
                        }
                        hx-get="?part=contributors&sort=recent"
                        hx-target="#contributors-section"
                        hx-indicator="#contributors-sort-indicator"
                    >Recent</button>
                </span>
            </div>
            <div class="contributors-container" id="contributors-container">
                for _, info := range contributors {
                    @Contributor(info)
                }
            </div>
        </div>
    }
}
