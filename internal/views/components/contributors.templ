// DEPRECATED: This file will be removed when contributor list logic is folded
// into sidebar_card.templ. Prefer adding new sidebar-related code there.
package components

import (
	"fmt"

	"merge/internal/model"
)

templ Contributors(contributors []model.ContributorInfo, activeSort string, filters model.FilterSet) {
    <section class="contributors">
        <div class="section-heading">
            <span>Contributors</span>
            <span class="buttons">
                <i id="contributors-sort-indicator" class="fa-solid fa-spinner fa-spin htmx-indicator" aria-hidden="true"></i>
                <span class="sort-label">SORT:</span>
                <button
                    if activeSort == "recent" {
                        data-active-sort="true"
                    }
                    hx-get={ fmt.Sprintf("?part=contributors&sort=recent") }
                    hx-target="#contributors-section"
                    hx-indicator="#contributors-sort-indicator"
                >
                    Recent
                </button>
                <button
                    if activeSort == "top" {
                        data-active-sort="true"
                    }
                    hx-get={ fmt.Sprintf("?part=contributors&sort=top") }
                    hx-target="#contributors-section"
                    hx-indicator="#contributors-sort-indicator"
                >
                    Top
                </button>
            </span>
        </div>
        if len(contributors) > 0 {
            <div class="contributors-container">
                for _, info := range contributors {
                    @Contributor(info, filters)
                }
            </div>
        }
        if filters.Contributor != "" {
            {{ clearPath := filters.WithContributor("").URL() }}
            <div class="scope-notice">
                <span><a href={ templ.SafeURL(clearPath) } hx-get={ templ.SafeURL(clearPath) } hx-target="main" hx-push-url="true">Clear filter</a></span>
            </div>
        }
    </section>
}
