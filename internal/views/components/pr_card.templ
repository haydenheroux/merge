package components

import (
	"fmt"

	"merge/internal/model"
	"merge/internal/views/helpers"
)

templ PRCard(pr model.StampedPullRequest, owner, repo string) {
	<div
		class="item pull-request"
		data-draft={ fmt.Sprintf("%t", pr.IsDraft) }
		data-pr-number={ fmt.Sprintf("%d", pr.Number) }
		data-pr-title={ pr.Title }
		data-pr-status-class={ helpers.GetStatusClass(pr) }
		data-pr-url={ pr.URL }
		data-pr-state={ pr.State }
		data-pr-age={ model.TimeAgo(pr.TimeOpen, pr.DaysOpen) }
		data-pr-author-name={ pr.Author.Name }
		data-pr-author-url={ pr.Author.URL }
		if len(pr.Scopes) > 0 {
			data-pr-scope={ pr.Scopes[0] }
			data-pr-scope-url={ fmt.Sprintf("/%s/%s/%s", owner, repo, pr.Scopes[0]) }
		}
		hx-on:click="Alpine.store('contextPane').openPane(Number(this.dataset.prNumber), this.dataset)"
	>
        <div class="pull-request-header">
            <div class="icon-container">
                <i class={ fmt.Sprintf("status-icon fa-solid %s", helpers.GetStatusClass(pr)) }></i>
            </div>
            <div class="title-row">
                <b class="title">@Markdown(pr.Title)</b>
            </div>
            <div class="description-row">
                <span>
                    #{ pr.Number }
                </span>
                <span>
                    { pr.State }
                </span>
                <span>
                    { model.TimeAgo(pr.TimeOpen, pr.DaysOpen) }
                </span>
                <span>
                    <a href={ pr.Author.URL }>{ pr.Author.Name }</a>
                </span>
				for _, scope := range pr.Scopes {
					<span>
                        <a href={ fmt.Sprintf("/%s/%s/%s", owner, repo, scope) } hx-get={ fmt.Sprintf("/%s/%s/%s", owner, repo, scope) } hx-target="main" hx-push-url="true">{ scope }</a>
                    </span>
				}
            </div>
        </div>
	</div>
}
