package components

import (
	"fmt"
	"math"

	"merge/internal/model"
	"merge/internal/views/helpers"
	"time"
)

func ageLabel(open time.Duration, days int) string {
	if open.Hours() < 1 {
		mins := int(math.Floor(open.Minutes()))
		return fmt.Sprintf("%dm", mins)
	}
	if days < 1 {
		hrs := int(math.Floor(open.Hours()))
		return fmt.Sprintf("%dh", hrs)
	}
	if days == 1 {
		return "1d"
	}
	if days < 7 {
		return fmt.Sprintf("%dd", days)
	}
	weeks := days / 7
	if weeks < 4 {
		return fmt.Sprintf("%dw", weeks)
	}
	months := weeks / 4
	if months < 12 {
		return fmt.Sprintf("%dmo", months)
	}
	years := months / 12
	return fmt.Sprintf("%dyr", years)
}

func prStateBadge(state string) string {
	switch state {
	case "Merged":
		return "badge-merged"
	case "Draft":
		return "badge-neutral"
	case "Closed":
		return "badge-danger"
	default:
		return "badge-success"
	}
}

templ PRCard(pr model.StampedPullRequest, owner, repo string) {
	<div
		class="item pull-request"
		data-pr-number={ fmt.Sprintf("%d", pr.Number) }
		data-pr-title={ pr.Title }
		data-pr-author={ pr.Author.Name }
		data-pr-state={ string(pr.State) }
		data-has-body={ fmt.Sprintf("%t", pr.Body != "") }
		tabindex="0"
		role="button"
	>
		<div class="pr-header">
			<div class="pr-icon">
				<i class={ fmt.Sprintf("fa-solid %s", helpers.GetStatusClass(pr)) }></i>
			</div>
			<div class="pr-content">
				<div class="pr-title-row">
					<span class="pr-title">{ pr.Title }</span>
					<span class="pr-number">#{ fmt.Sprintf("%d", pr.Number) }</span>
				</div>
				<div class="pr-meta">
					<span class={ fmt.Sprintf("pr-meta-item %s", prStateBadge(string(pr.State))) } style="padding:0 6px;border-radius:8px;font-weight:500">
						{ string(pr.State) }
					</span>
					<span class="pr-meta-item">
						<i class="fa-regular fa-clock"></i>
						{ ageLabel(pr.TimeOpen, pr.DaysOpen) }
					</span>
					<span class="pr-meta-item pr-author">
						<img src={ pr.Author.AvatarURL } alt=""/> { pr.Author.Name }
					</span>
					for _, scope := range pr.Scopes {
						<span class="pr-meta-item">
							<a href={ fmt.Sprintf("/%s/%s/%s", owner, repo, scope) } hx-get={ fmt.Sprintf("/%s/%s/%s", owner, repo, scope) } hx-target="#app-shell" hx-push-url="true" style="color:var(--clr-accent)">{ scope }</a>
						</span>
					}
				</div>
				<div class="pr-diff">
					<span class="diff-additions">+120</span>
					<span class="diff-deletions">-10</span>
				</div>
			</div>
		</div>
		if pr.Body != "" {
			<div class="pr-body">
				@Markdown(pr.Body)
			</div>
		}
	</div>
}
