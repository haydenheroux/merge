package components

import (
	"fmt"
	"math"

	"merge/internal/model"
	"merge/internal/views/helpers"
	"time"
)

func ageLabel(open time.Duration, days int) string {
    // TODO Explicit fallthrough, remainder, plurals
	if open.Hours() < 1 {
		mins := int(math.Floor(open.Minutes()))
		return fmt.Sprintf("%dm ago", mins)
	}

	if days < 1 {
		hrs := int(math.Floor(open.Hours()))
		return fmt.Sprintf("%dhrs ago", hrs)
	}

	if days == 1 {
		return "Yesterday"
	}

    if days < 7 {
        return fmt.Sprintf("%dd ago", days)
    }

    weeks := days / 7
    if weeks < 4 {
        return fmt.Sprintf("%dwk ago", weeks)
    }

    months := weeks / 4
    if months < 12 {
        return fmt.Sprintf("%dmo ago", months)
    }

    years := months / 12
    return fmt.Sprintf("%dyr ago", years)
}

templ PRCard(pr model.StampedPullRequest, owner, repo string) {
	<div
		class="item pull-request"
		data-draft={ fmt.Sprintf("%t", pr.IsDraft) }
		data-pr-number={ fmt.Sprintf("%d", pr.Number) }
		hx-on:click="Alpine.store('contextPane').openPane(Number(this.dataset.prNumber))"
	>
        <div class="pull-request-header">
            <div class="icon-container">
                <i class={ fmt.Sprintf("status-icon fa-solid %s", helpers.GetStatusClass(pr)) }></i>
            </div>
            <div class="title-row">
                <b class="title">@Markdown(pr.Title)</b>
            </div>
            <div class="description-row">
                <span>
                    #{ pr.Number }
                </span>
                <span>
                    { pr.State }
                </span>
                <span>
                    { ageLabel(pr.TimeOpen, pr.DaysOpen) }
                </span>
                <span>
                    <a href={ pr.Author.URL }>{ pr.Author.Name }</a>
                </span>
				for _, scope := range pr.Scopes {
					<span>
                        <a href={ fmt.Sprintf("/%s/%s/%s", owner, repo, scope) } hx-get={ fmt.Sprintf("/%s/%s/%s", owner, repo, scope) } hx-target="main" hx-push-url="true">{ scope }</a>
                    </span>
				}
            </div>
        </div>
	</div>
}
