package components

import "fmt"
import "merge/internal/model"

templ Scope(info model.ScopeInfo, currentPath string) {
    <div class="item scope">
        <div class="text">
            <a class="title" href={ fmt.Sprintf("%s/%s", currentPath, info.Name) } hx-get={ fmt.Sprintf("%s/%s", currentPath, info.Name) } hx-target="main" hx-push-url="true">{ info.Name }</a>
            <p class="age">{ info.NewestPRAge }</p>
        </div>
    </div>
}
