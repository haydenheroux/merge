package components

import (
	"fmt"
	"strings"

	"merge/internal/model"
	"merge/internal/views/helpers"
)

templ Scopes(scopes []model.ScopeInfo, activeSort, currentPath, scope, contributor, status string) {
	<section class="scopes">
		<div class="section-heading">
			<span>Scopes</span>
			if len(scopes) > 0 || scope != "" {
				<span class="buttons">
					<i id="scopes-sort-indicator" class="fas fa-circle-notch fa-spin htmx-indicator" aria-hidden="true"></i>
					<span class="sort-label">SORT:</span>
				<button
					if activeSort == "recent" {
						data-active-sort="true"
					}
					hx-get={ fmt.Sprintf("?part=scopes&sort=recent") }
					hx-target="#scopes-section"
					hx-indicator="#scopes-sort-indicator"
				>
					Recent
				</button>
				<button
					if activeSort == "top" {
						data-active-sort="true"
					}
					hx-get={ fmt.Sprintf("?part=scopes&sort=top") }
					hx-target="#scopes-section"
					hx-indicator="#scopes-sort-indicator"
				>
					Top
				</button>
				</span>
			}
		</div>
		if len(scopes) > 0 {
			<div class="scopes-container">
			for _, info := range scopes {
				@Scope(info, currentPath, scope, contributor, status)
			}
			</div>
		}
		if scope != "" {
			{{ clearPath := helpers.StripQueryParam(strings.TrimSuffix(currentPath, "/"+scope), "status")
			clearPath = helpers.StripQueryParam(clearPath, "contributor")
			q := []string{}
			if contributor != "" {
				q = append(q, "contributor="+contributor)
			}
			if status != "" {
				q = append(q, "status="+status)
			}
			if len(q) > 0 {
				clearPath += "?" + strings.Join(q, "&")
			}
			}}
			<div class="scope-notice">
				<span><a href={ templ.SafeURL(clearPath) } hx-get={ templ.SafeURL(clearPath) } hx-target="main" hx-push-url="true">Clear filter</a></span>
			</div>
		}
	</section>
}
