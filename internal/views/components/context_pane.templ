package components

templ ContextPane() {
	<aside
		class="context-pane bottom-sheet"
		id="context-pane"
		:class="{ 'open': $store.contextPane.open }"
		@keydown.escape.window="$store.contextPane.closePane()"
	>
		<div id="context-pane-content">
			<div class="context-pane-header">
				<a class="context-pane-title" :href="$store.contextPane.prUrl" x-show="$store.contextPane.open">
					<i class="status-icon fa-solid" :class="$store.contextPane.prStatusClass"></i>
					<span x-html="$store.contextPane.prTitle"></span>
					<i class="fa-solid fa-up-right-from-square"></i>
				</a>
				<button class="button-toggle" aria-label="Close" onclick="Alpine.store('contextPane').closePane()">
					<i class="fa-solid fa-xmark" aria-hidden="true"></i>
				</button>
			</div>
			<div class="context-pane-body scroll">
				<div class="context-pane-meta" x-show="$store.contextPane.open">
					<div class="meta-row">
						<span class="meta-label">
							<i class="fa-solid fa-hashtag"></i>
							Number
						</span>
						<span class="meta-value" x-text="'#' + $store.contextPane.prNumber"></span>
					</div>
					<div class="meta-row">
						<span class="meta-label">
							<i class="fa-solid fa-code-pull-request"></i>
							Status
						</span>
						<span class="meta-value" x-text="$store.contextPane.prState"></span>
					</div>
					<div class="meta-row">
						<span class="meta-label">
							<i class="fa-solid fa-clock"></i>
							Age
						</span>
						<span class="meta-value" x-text="$store.contextPane.prAge"></span>
					</div>
					<div class="meta-row">
						<span class="meta-label">
							<i class="fa-solid fa-user"></i>
							Author
						</span>
						<a
							class="meta-value meta-link"
							:href="$store.contextPane.prAuthorUrl"
							x-text="$store.contextPane.prAuthorName"
						></a>
					</div>
					<template x-if="$store.contextPane.prScope">
						<div class="meta-row">
							<span class="meta-label">
								<i class="fa-solid fa-tag"></i>
								Scope
							</span>
							<a
								class="meta-value meta-link"
								:href="$store.contextPane.prScopeUrl"
								x-text="$store.contextPane.prScope"
							></a>
						</div>
					</template>
				</div>
				<div x-show="$store.contextPane.open" x-html="$store.contextPane.bodyHtml"></div>
			</div>
		</div>
	</aside>
}
