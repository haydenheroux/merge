package components

import "fmt"

templ Nav(owner, repo string) {
	<nav id="nav">
        <h4 id="nav-input" class="serif bold">
            <a href="/">Merge Zone</a>
            if owner != "" {
                <span class="serif bold title-sep">/</span>
                <input class="serif bold title-input" type="text" data-part="owner" value={ owner }>
                if repo != "" {
                    <span class="serif bold title-sep">/</span>
                    <input class="serif bold title-input" type="text" data-part="repo" value={ repo }>
                    <a id="github-link" href={ fmt.Sprintf("https://github.com/%s/%s/pulls", owner, repo) } aria-label="Navigate to GitHub"><i class="fa-brands fa-github-alt link-button" aria-hidden="true"></i></a>
                }
            }
        </h4>
		<div id="nav-form-wrapper">
			@RepoForm("nav-repo-form")
		</div>
		<button id="nav-toggle" aria-label="Toggle repo search" type="button">
			<i class="fa-solid fa-search"></i>
		</button>
	</nav>
}
