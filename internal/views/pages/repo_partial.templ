package pages

import (
	"merge/internal/model"
	"merge/internal/views/components"
)

templ RepoContent(props model.RepoPageProps, currentPath string) {
	{{ filters := model.FilterSet{Owner: props.Owner, Repo: props.Repo, Scope: props.Scope, Contributor: props.Contributor, Status: props.Status} }}
	@components.Sidebar(filters, props.ScopeCounts, props.ScopeSort, props.ContributorCounts, props.ContributorSort)
	<section class="scroll">
		<div class="overview" id="overview-stats">
			@components.Counts(props.OverallCounts, props.HasMore, filters, props.CurrentPage + 1)
		</div>
		@components.PRScrollSection(props.PRs, filters, props.CurrentPage, props.HasMore)
	</section>
	@components.FilterPanel()
	@components.ContextPane()
}
