package pages

import (
	"fmt"

	"merge/internal/model"
	"merge/internal/views/components"
)

templ RepoContent(props model.RepoPageProps) {
	<header class="repo-header">
		<div>
			<h2 class="repo-title">
				<span>{ props.Owner }</span>
				<span class="title-sep">/</span>
				<span>{ props.Repo }</span>
			</h2>
			<a href={ fmt.Sprintf("https://github.com/%s/%s/pulls", props.Owner, props.Repo) } aria-label="Navigate to GitHub"><i class="fa-brands fa-github-alt link-button" aria-hidden="true"></i></a>
		</div>
		<div class="stats">
			@components.Stats("fa-code-merge special", props.MergedCount, "merged pull requests")
			@components.Stats("fa-apple-whole ok", props.FreshCount, "fresh pull requests")
			@components.Stats("fa-apple-whole warn", props.StaleCount, "stale pull requests")
			@components.Stats("fa-recycle error", props.ExpiredCount, "expired pull requests")
		</div>
	</header>
	<main class="prs">
		<div class="prs-scroll">
		for _, pr := range props.PRs {
			@components.PRCard(pr)
		}
		</div>
	</main>
}
