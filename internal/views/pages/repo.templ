package pages

import (
	"fmt"
	"strings"

	"merge/internal/model"
	"merge/internal/views/layout"
	"merge/internal/views/components"
)

templ RepoPage(props model.RepoPageProps, currentPath string) {
	@layout.Base(
		fmt.Sprintf("%s/%s", props.Owner, props.Repo),
		fmt.Sprintf("%d fresh pull requests; %d stale pull requests; %d expired pull requests", props.OverallCounts.FreshCount, props.OverallCounts.StaleCount, props.OverallCounts.ExpiredCount),
		props.BaseURL,
		props.Owner,
		props.Repo,
		strings.Trim(strings.TrimPrefix(currentPath, fmt.Sprintf("/%s/%s", props.Owner, props.Repo)), "/"),
	) {
		<div class="app-shell" id="app-shell">
			<aside class="pane pane-left">
				@components.Nav(props.Owner, props.Repo, props.Scope)
				<div class="pane-left-scroll">
					<div id="scopes-section">
						@components.Scopes(props.ScopeCounts, props.ScopeSort, currentPath)
					</div>
					<div id="contributors-section">
						@components.Contributors(props.ContributorCounts, props.ContributorSort)
					</div>
				</div>
			</aside>
			<main class="pane pane-center">
				<div class="mobile-header">
					<span class="mobile-header-logo">Merge Zone</span>
					<select class="mobile-workspace-selector desktop-only">
						<option>{ props.Owner }/{ props.Repo }</option>
					</select>
					<div class="mobile-tab-bar">
						<button class="mobile-tab active" data-view="center">Feed</button>
						<button class="mobile-tab" data-view="left">Stats</button>
						<button class="mobile-tab" data-view="right">Details</button>
					</div>
				</div>
				<div class="pane-center-inner">
					<div class="overview" id="overview-stats">
						@components.Counts(props.OverallCounts, props.HasMore, props.Owner, props.Repo, props.CurrentPage + 1)
					</div>
					<section class="prs">
						<div class="section-header">
							<span class="section-title">Pull Requests</span>
						</div>
						<div class="prs-list" id="prs-list">
						for _, pr := range props.PRs {
							@components.PRCard(pr, props.Owner, props.Repo)
						}
						</div>
					</section>
				</div>
			</main>
			<aside class="pane pane-right" id="right-pane">
				<div id="right-pane-content" class="right-pane-content"></div>
			</aside>
		</div>
	}
}
