package pages

import (
	"merge/internal/views/components"
	"merge/internal/views/layout"
)

templ IndexPage(baseURL, owner, repo string) {
	@layout.Base("Merge Zone", "Know your contributors. Build your community.", baseURL, owner, repo, "") {
		<aside class="aside-column">
				@components.Nav(owner, repo, "")
				<section class="scroll">
					<div class="section-heading">
						<span>How it works</span>
					</div>
					<div class="item-group-tall">
						@components.IconRow("fa-brands fa-github", "", "Enter a GitHub repo", "Paste any public repository URL or owner/name")
						@components.IconRow("fa-solid fa-code-merge", "", "Analyze pull requests", "We fetch recent PRs and categorize by activity")
						@components.IconRow("fa-solid fa-users", "", "Understand contributors", "See who's active, consistent, and where they focus")
					</div>
				</section>
				<footer>
					<span>Made by <a class="bold" href="https://www.haydenheroux.com">Hayden Heroux</a></span>
					<span>View on <a class="bold" href="https://www.github.com/mergezone/mergezone">GitHub</a></span>
					<span>View on <a class="bold" href="https://www.merge.zone/mergezone/mergezone">Merge Zone</a></span>
				</footer>
			</aside>
			<section class="scroll">
				<h1>Know your contributors.<br/>Build your community.</h1>
				<div>
					<div class="section-heading">
						<span>Features</span>
					</div>
					<div class="scroll-content item-group">
						@components.IconRow("fa-solid fa-seedling", "ok", "Fresh / Stale / Expired", "PRs are categorized by activity level to show engagement patterns")
						@components.IconRow("fa-solid fa-code-merge", "special", "Merge tracking", "See which contributors are getting their PRs merged successfully")
						@components.IconRow("fa-solid fa-folder-tree", "warn", "Scope analysis", "Identify which areas of your codebase attract the most contributions")
						@components.IconRow("fa-solid fa-users", "error", "Contributor profiles", "Vet potential contributors by their pull request history")
					</div>
				</div>
				<div>
					<div class="section-heading">
						<span>Popular repos</span>
					</div>
					<div class="scroll-content item-group home-repos">
						@components.RepoLink("mergezone", "mergezone", "fa-solid fa-code-merge")
						@components.RepoLink("ghostty-org", "ghostty", "fa-solid fa-terminal")
						@components.RepoLink("kubernetes", "kubernetes", "fa-solid fa-dharmachakra")
						@components.RepoLink("home-assistant", "core", "fa-solid fa-house")
						@components.RepoLink("huggingface", "transformers", "fa-solid fa-brain")
						@components.RepoLink("flutter", "flutter", "fa-solid fa-wand-magic-sparkles")
						@components.RepoLink("nixos", "nixpkgs", "fa-solid fa-snowflake")
						@components.RepoLink("microsoft", "vscode", "fa-solid fa-code")
						@components.RepoLink("hashicorp", "terraform", "fa-solid fa-cubes")
						@components.RepoLink("denoland", "deno", "fa-solid fa-diamond")
					</div>
				</div>
			</section>
	}
}
