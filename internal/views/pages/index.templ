package pages

import (
	"merge/internal/views/components"
	"merge/internal/views/layout"
)

templ IndexPage(baseURL, owner, repo string) {
	@layout.Base("Merge Zone", "Know your contributors. Build your community.", baseURL, owner, repo, "") {
		<aside class="aside-column">
				@components.Nav(owner, repo, "")
				<div class="scroll">
					<section class="scopes">
						<div class="section-heading">
							<span>How it works</span>
						</div>
						<div class="item home-step">
							<div class="home-step-icon">
								<i class="fa-brands fa-github" aria-hidden="true"></i>
							</div>
							<div class="home-step-content">
								<p class="bold">Enter a GitHub repo</p>
								<p class="small">Paste any public repository URL or owner/name</p>
							</div>
						</div>
						<div class="item home-step">
							<div class="home-step-icon">
								<i class="fa-solid fa-code-merge" aria-hidden="true"></i>
							</div>
							<div class="home-step-content">
								<p class="bold">Analyze pull requests</p>
								<p class="small">We fetch recent PRs and categorize by activity</p>
							</div>
						</div>
						<div class="item home-step">
							<div class="home-step-icon">
								<i class="fa-solid fa-users" aria-hidden="true"></i>
							</div>
							<div class="home-step-content">
								<p class="bold">Understand contributors</p>
								<p class="small">See who's active, consistent, and where they focus</p>
							</div>
						</div>
					</section>
				</div>
				<footer>
					<span>Made by <a class="bold" href="https://www.haydenheroux.com">Hayden Heroux</a></span>
					<span>View on <a class="bold" href="https://www.github.com/mergezone/mergezone">GitHub</a></span>
					<span>View on <a class="bold" href="https://www.merge.zone/mergezone/mergezone">Merge Zone</a></span>
				</footer>
			</aside>
			<section class="scroll">
				<h1>Know your contributors.<br/>Build your community.</h1>
				<div>
					<div class="section-heading">
						<span>Popular repos</span>
					</div>
					<div class="scroll-content home-repos">
						<a href="/mergezone/mergezone" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-code-merge"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">mergezone</span>
								<span class="sep">/</span>
								<span class="repo bold">mergezone</span>
							</div>
						</a>
						<a href="/ghostty-org/ghostty" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-terminal"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">ghostty-org</span>
								<span class="sep">/</span>
								<span class="repo bold">ghostty</span>
							</div>
						</a>
						<a href="/kubernetes/kubernetes" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-dharmachakra"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">kubernetes</span>
								<span class="sep">/</span>
								<span class="repo bold">kubernetes</span>
							</div>
						</a>
						<a href="/home-assistant/core" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-house"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">home-assistant</span>
								<span class="sep">/</span>
								<span class="repo bold">core</span>
							</div>
						</a>
						<a href="/huggingface/transformers" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-brain"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">huggingface</span>
								<span class="sep">/</span>
								<span class="repo bold">transformers</span>
							</div>
						</a>
						<a href="/flutter/flutter" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-wand-magic-sparkles"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">flutter</span>
								<span class="sep">/</span>
								<span class="repo bold">flutter</span>
							</div>
						</a>
						<a href="/nixos/nixpkgs" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-snowflake"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">nixos</span>
								<span class="sep">/</span>
								<span class="repo bold">nixpkgs</span>
							</div>
						</a>
						<a href="/microsoft/vscode" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-code"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">microsoft</span>
								<span class="sep">/</span>
								<span class="repo bold">vscode</span>
							</div>
						</a>
						<a href="/hashicorp/terraform" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-cubes"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">hashicorp</span>
								<span class="sep">/</span>
								<span class="repo bold">terraform</span>
							</div>
						</a>
						<a href="/denoland/deno" class="item home-repo">
							<div class="home-repo-icon">
								<i class="fa-solid fa-diamond"></i>
							</div>
							<div class="home-repo-text">
								<span class="owner">denoland</span>
								<span class="sep">/</span>
								<span class="repo bold">deno</span>
							</div>
						</a>
					</div>
				</div>
				<div>
					<div class="section-heading">
						<span>Features</span>
					</div>
					<div class="scroll-content home-features">
						<div class="item home-feature">
							<div class="home-feature-icon ok">
								<i class="fa-solid fa-seedling"></i>
							</div>
							<div class="home-feature-content">
								<p class="bold">Fresh / Stale / Expired</p>
								<p class="small">PRs are categorized by activity level to show engagement patterns</p>
							</div>
						</div>
						<div class="item home-feature">
							<div class="home-feature-icon special">
								<i class="fa-solid fa-code-merge"></i>
							</div>
							<div class="home-feature-content">
								<p class="bold">Merge tracking</p>
								<p class="small">See which contributors are getting their PRs merged successfully</p>
							</div>
						</div>
						<div class="item home-feature">
							<div class="home-feature-icon warn">
								<i class="fa-solid fa-folder-tree"></i>
							</div>
							<div class="home-feature-content">
								<p class="bold">Scope analysis</p>
								<p class="small">Identify which areas of your codebase attract the most contributions</p>
							</div>
						</div>
						<div class="item home-feature">
							<div class="home-feature-icon error">
								<i class="fa-solid fa-users"></i>
							</div>
							<div class="home-feature-content">
								<p class="bold">Contributor profiles</p>
								<p class="small">Vet potential contributors by their pull request history</p>
							</div>
						</div>
					</div>
				</div>
			</section>
	}
}
