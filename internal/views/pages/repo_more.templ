package pages

import (
	"merge/internal/model"
	"merge/internal/views/components"
)

templ LoadMorePRs(
	prs []model.StampedPullRequest,
	filters model.FilterSet,
	nextPage int,
	hasMore bool,
	overallCounts model.ExpiryCounts,
	scopeCounts []model.ScopeInfo,
	scopeSort string,
	contributorCounts []model.ContributorInfo,
	contributorSort string,
) {
	@components.PRScrollItems(prs, filters.Owner, filters.Repo)
	@components.LoadMoreCard(prs, filters, nextPage, hasMore, true)
	<div id="overview-stats" hx-swap-oob="true">
		@components.Counts(overallCounts, hasMore, filters, nextPage)
	</div>
	<div id="scopes-section" hx-swap-oob="true">
		@components.Scopes(scopeCounts, scopeSort, filters)
	</div>
	<div id="contributors-section" hx-swap-oob="true">
		@components.Contributors(contributorCounts, contributorSort, filters)
	</div>
}
