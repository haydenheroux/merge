package pages

import (
	"fmt"

	"merge/internal/model"
	"merge/internal/views/components"
)

templ LoadMorePRs(
	prs []model.StampedPullRequest,
	owner string,
	repo string,
	nextPage int,
	hasMore bool,
	overallCounts model.ExpiryCounts,
	scopeCounts []model.ScopeInfo,
	contributorCounts []model.ContributorInfo,
) {
	for _, pr := range prs {
		@components.PRCard(pr)
	}
	<div id="overview-stats" hx-swap-oob="true">
		@components.Counts(overallCounts)
	</div>
	<div id="scopes-section" hx-swap-oob="true">
		@components.Scopes(scopeCounts)
	</div>
	<div id="contributors-section" hx-swap-oob="true">
		@components.Contributors(contributorCounts)
	</div>
	<span id="load-more-nav-btn" hx-swap-oob="true">
		if hasMore {
			<i
				class="fa-solid fa-arrows-rotate link-button"
				role="button"
				tabindex="0"
				aria-label="Load more pull requests"
				hx-get={ fmt.Sprintf("/%s/%s?page=%d", owner, repo, nextPage) }
				hx-target="#prs-scroll"
				hx-swap="beforeend"
			></i>
		}
	</span>
}
