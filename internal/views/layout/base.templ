package layout

templ Base(title, description, baseURL, owner, repo, scope string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<title>{ title }</title>
		<link rel="icon" type="image/png" href="/public/favicon.png">
		<link rel="stylesheet" href="/public/main.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
		<script src="https://unpkg.com/htmx.org@1.9.12"></script>
		<meta name="description" content={ description }/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta property="og:title" content={ title }/>
		<meta property="og:type" content="website"/>
		<meta property="og:url" content={ baseURL }/>
		<meta property="og:description" content={ description }/>
	</head>
	<body if owner != "" { class="repo-page" }>
		if owner != "" {
			{ children... }
			<nav class="bottom-nav" id="bottom-nav">
				<button class="bottom-nav-item active" data-view="center">
					<i class="fa-solid fa-code-pull-request"></i>
					<span>Activity</span>
				</button>
				<button class="bottom-nav-item" data-view="left">
					<i class="fa-solid fa-layer-group"></i>
					<span>Projects</span>
				</button>
				<button class="bottom-nav-item" data-view="right">
					<i class="fa-solid fa-chart-bar"></i>
					<span>Stats</span>
				</button>
			</nav>
		} else {
			<main>
				{ children... }
			</main>
			<footer>
				<span>By <a href="https://www.haydenheroux.com">Hayden Heroux</a></span>
				<span>View on <a href="https://www.github.com/mergezone/mergezone">GitHub</a></span>
				<span>View on <a href="https://www.merge.zone/mergezone/mergezone">Merge Zone</a></span>
			</footer>
		}
		<script src="/public/pr-toggle.js" defer></script>
		<script>
		(function() {
			var stored = localStorage.getItem('theme');
			var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			if (stored === 'dark' || (!stored && prefersDark)) {
				document.documentElement.classList.add('dark');
			}
			function updateThemeIcon() {
				var isDark = document.documentElement.classList.contains('dark');
				var icon = document.querySelector('#theme-toggle i');
				if (icon) {
					icon.className = isDark ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
				}
			}
			var toggle = document.querySelector('#theme-toggle');
			if (toggle) {
				toggle.addEventListener('click', function() {
					document.documentElement.classList.toggle('dark');
					var isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
					updateThemeIcon();
				});
			}
			updateThemeIcon();
		})();
		</script>
		<script defer>
		document.addEventListener('submit', function(e) {
			var form = e.target.closest('.repo-form');
			if (!form) return;
			e.preventDefault();
			var owner = form.querySelector('.owner-input').value.trim();
			var repo = form.querySelector('.repo-input').value.trim();
			if (repo) {
				window.location.href = '/' + owner + '/' + repo;
			}
		});

		(function() {
			var mobileTabs = document.querySelectorAll('.bottom-nav-item, .mobile-tab');
			mobileTabs.forEach(function(tab) {
				tab.addEventListener('click', function() {
					var view = this.dataset.view;
					if (!view) return;
					mobileTabs.forEach(function(t) { t.classList.remove('active'); });
					this.classList.add('active');
					var panes = document.querySelectorAll('.pane');
					panes.forEach(function(p) { p.classList.remove('active'); });
					var pane = document.querySelector('.pane-' + view);
					if (pane) pane.classList.add('active');
				});
			});

			var prCards = document.querySelectorAll('.pull-request');
			prCards.forEach(function(card) {
				card.addEventListener('click', function(e) {
					if (e.target.closest('a') || e.target.closest('.pr-body')) return;
					prCards.forEach(function(c) { c.classList.remove('selected'); });
					this.classList.add('selected');
					var num = this.dataset.prNumber;
					var title = this.dataset.prTitle;
					var author = this.dataset.prAuthor;
					var state = this.dataset.prState;
					var icon = this.querySelector('.pr-icon i');
					var iconClass = icon ? icon.className : 'fa-solid fa-code-pull-request';
					fillRightPane(num, title, author, state, iconClass);
					if (window.innerWidth <= 768) {
						var detailTab = document.querySelector('[data-view="right"]');
						if (detailTab) detailTab.click();
					}
				});
			});

			function fillRightPane(num, title, author, state, iconClass) {
				var container = document.getElementById('right-pane-content');
				if (!container) return;
				container.innerHTML = '';
				var detailDiv = document.createElement('div');
				detailDiv.className = 'right-pane-content';
				detailDiv.innerHTML = getPRDetailHTML(num, title, author, state, iconClass);
				container.appendChild(detailDiv);
				container.scrollTop = 0;
			}

			function getPRDetailHTML(num, title, author, state, iconClass) {
				var stateBadge = 'badge-neutral';
				var stateLabel = state || 'Open';
				if (state === 'Merged') { stateBadge = 'badge-merged'; }
				else if (state === 'Draft') { stateBadge = 'badge-neutral'; }
				else if (state === 'Closed') { stateBadge = 'badge-danger'; }
				else { stateBadge = 'badge-success'; }
				var files = [
					{ path: 'src/components/App.tsx', add: 24, del: 5 },
					{ path: 'src/hooks/useAuth.ts', add: 12, del: 3 },
					{ path: 'src/utils/helpers.ts', add: 8, del: 1 },
					{ path: 'tests/App.test.tsx', add: 15, del: 0 }
				];
				var filesHTML = files.map(function(f) {
					return '<div class="file-item"><span class="file-path">' + f.path + '</span><span class="file-stats"><span class="text-success">+' + f.add + '</span><span class="text-danger">-' + f.del + '</span></span></div>';
				}).join('');

				return '<div class="pr-detail-header">' +
					'<div class="pr-detail-title">' + title + '</div>' +
					'<div class="pr-detail-number">#' + num + '</div>' +
					'</div>' +
					'<div class="pr-detail-meta">' +
					'<span class="' + stateBadge + '" style="padding:2px 8px;border-radius:12px;font-size:12px;font-weight:500">' +
					'<i class="' + iconClass + '"></i> ' + stateLabel + '</span>' +
					'<span>' + author + '</span>' +
					'</div>' +
					'<div class="section-header"><span class="section-title">Files Changed</span></div>' +
					'<div class="file-list">' + filesHTML + '</div>' +
					'<div class="section-header" style="margin-top:16px"><span class="section-title">File Diff</span></div>' +
					'<div class="file-diff"><div class="diff-header"><span class="mono">' + files[0].path + '</span></div>' +
					'<div class="diff-line diff-add"><span class="diff-lineno">12</span><span class="diff-content"><span class="text-success">+ import { useAuth } from "../hooks/useAuth"</span></span></div>' +
					'<div class="diff-line"><span class="diff-lineno">13</span><span class="diff-content"> </span></div>' +
					'<div class="diff-line diff-remove"><span class="diff-lineno">14</span><span class="diff-content"><span class="text-danger">- const api = new APIClient()</span></span></div>' +
					'<div class="diff-line diff-add"><span class="diff-lineno">15</span><span class="diff-content"><span class="text-success">+ const { api } = useAuth()</span></span></div>' +
					'</div>' +
					'<div class="section-header" style="margin-top:16px"><span class="section-title">Comments</span></div>' +
					'<div class="comment-section">' +
					'<div class="comment"><div class="comment-avatar" style="background:#E8E8E8"></div><div class="comment-body"><div class="comment-author">reviewer-bot</div><div class="comment-text">LGTM! Just one nit: we should handle the edge case where the token is undefined.</div><div class="comment-reactions"><span class="reaction">👍 3</span><span class="reaction">🚀 1</span></div></div></div>' +
					'<div class="comment"><div class="comment-avatar" style="background:#D0D0D0"></div><div class="comment-body"><div class="comment-author">' + author + '</div><div class="comment-text">Good catch, updated the PR.</div><div class="comment-reactions"><span class="reaction">❤️ 2</span></div></div></div>' +
					'</div>' +
					'<div class="section-header" style="margin-top:16px"><span class="section-title">CI/CD Pipeline</span></div>' +
					'<div class="ci-log">' +
					'<div class="ci-line"><span class="ci-step">$</span> git checkout origin/pr/' + num + '</div>' +
					'<div class="ci-line"><span class="ci-step">$</span> npm ci</div>' +
					'<div class="ci-line"><span class="ci-check">✓</span> Dependencies installed (2.4s)</div>' +
					'<div class="ci-line"><span class="ci-step">$</span> npm run lint</div>' +
					'<div class="ci-line"><span class="ci-check">✓</span> Lint passed (1.1s)</div>' +
					'<div class="ci-line"><span class="ci-step">$</span> npm run test</div>' +
					'<div class="ci-line"><span class="ci-check">✓</span> 47 tests passed (3.2s)</div>' +
					'<div class="ci-line"><span class="ci-step">$</span> npm run build</div>' +
					'<div class="ci-line"><span class="ci-check">✓</span> Build succeeded (5.8s)</div>' +
					'<div class="ci-status"><span class="ci-passed"><i class="fa-solid fa-check"></i> CI PASSED</span></div>' +
					'</div>';
			}
		})();
		</script>
	</body>
	</html>
}
